def parse_range(spec, n):
    if spec in (None, "all"):
        return list(range(1, n + 1))
    picked = set()
    for part in spec.split(","):
        a, _, b = part.partition("-")
        picked.update(range(int(a), int(b or a) + 1))
    return [i for i in sorted(picked) if 1 <= i <= n]


def ensure_notebook(book, state):
    if state.get("notebook_id"):
        return state["notebook_id"]
    nb = http("POST", NOTEBOOK_API + "/notebooks",
              {"name": book["title"], "description": f"{book['title']} by {book['author']}, split into chapters by book2podcast"})
    state["notebook_id"] = nb["id"]
    return nb["id"]


def add_source(book, n, chapter, state):
    key = str(n)
    if key in state.setdefault("sources", {}):
        return
    src = http("POST", NOTEBOOK_API + "/sources/json", {
        "type": "text", "notebooks": [state["notebook_id"]], "title": f"{n:02d}. {chapter['title']}",
        "content": chapter["text"], "embed": True, "async_processing": True}, timeout=300)
    state["sources"][key] = src.get("id")


def briefing_suffix(book, n, chapters):
    ch = chapters[n - 1]
    earlier = "\n".join(f"- {c['title']}: {c['summary']}" for c in chapters[:n - 1][-6:])
    return (f"\n\nSERIES CONTEXT: This episode covers chapter {n} of {len(chapters)}, \"{ch['title']}\", "
            f"from the book \"{book['title']}\"{' by ' + book['author'] if book['author'] else ''}. "
            "Treat it as one episode in a series that goes through the book chapter by chapter. "
            "Focus on this chapter only, but briefly connect it to earlier chapters where it helps.\n"
            + (f"Earlier chapters covered:\n{earlier}\n" if earlier else "This is the first episode of the series.\n"))


EPISODES_DIR = Path(setting("OPEN_NOTEBOOK_EPISODES", "open_notebook_episodes",
                            Path.home() / "open-notebook" / "notebook_data" / "podcasts" / "episodes")).expanduser()


class EpisodeWatch:
    """Stage of a running episode, read from what Open Notebook writes to disk:
    nothing while the model writes outline and script, then one clips/NNNN.mp3 per
    line of dialogue as voices are recorded, then the mixed file in audio/."""

    def __init__(self, started):
        self.started, self.checked, self.folder = started, 0.0, None
        self.first_clip = None
        # typical script length, from earlier episodes' transcripts
        lines = []
        for t in sorted(EPISODES_DIR.glob("*/transcript.json"), key=lambda p: p.stat().st_mtime)[-10:]:
            try:
                lines.append(len(json.loads(t.read_text())))
            except (OSError, ValueError, TypeError):
                pass
        self.expected = sum(lines) // len(lines) if lines else 0

    def describe(self, job_state):
        spent = time.time() - self.started
        if self.folder is None and EPISODES_DIR.is_dir():
            new = [d for d in EPISODES_DIR.iterdir() if d.is_dir() and d.stat().st_mtime >= self.started - 5]
            self.folder = max(new, key=lambda d: d.stat().st_mtime) if new else None
        clips = len(list((self.folder / "clips").glob("*.mp3"))) if self.folder else 0
        if self.folder and any((self.folder / "audio").glob("*.mp3")):
            return f"  mixing and saving the episode · {clock(spent)}"
        if clips:
            self.first_clip = self.first_clip or time.time()
            rate = clips / max(time.time() - self.first_clip, 1)
            if self.expected and clips < self.expected:
                left = f" of ~{self.expected} ({100 * clips // self.expected}%) · ~{clock((self.expected - clips) / rate)} left"
            else:
                left = ""
            return f"  recording voices: {clips} lines{left} · {clock(spent)} in"
        return f"  writing outline and script ({job_state}) · {clock(spent)}"


DONE_STATES = ("completed", "failed", "error", "canceled", "cancelled")


def submit_job(name, content, suffix, args):
    job = http("POST", NOTEBOOK_API + "/podcasts/generate", {
        "episode_profile": args.profile, "speaker_profile": args.speakers or args.profile,
        "episode_name": name, "content": content, "briefing_suffix": suffix})
    return job["job_id"]


def job_state(job_id):
    """The job's status, or None if Open Notebook no longer knows it (e.g. the
    container restarted and the worker lost it)."""
    try:
        return (http("GET", f"{NOTEBOOK_API}/podcasts/jobs/{job_id}") or {}).get("status")
    except urllib.error.HTTPError as e:
        if e.code in (404, 422):
            return None
        raise


def wait_job(job_id, name, started):
    """Wait for a submitted job (also one submitted by an earlier, interrupted
    run), return (episode, error)."""
    j, state = {}, "unknown"
    watch = EpisodeWatch(started)
    while True:
        if time.time() - watch.checked >= 30:   # the job itself, every 30 s
            watch.checked = time.time()
            try:
                j = http("GET", f"{NOTEBOOK_API}/podcasts/jobs/{job_id}") or {}
            except urllib.error.URLError as e:
                log(f"  (could not check job: {e}; retrying)")
                time.sleep(10)
                continue
            state = j.get("status", "unknown")
            if state in DONE_STATES:
                break
        status(watch.describe(state))
        time.sleep(10)
    log(f"  {state} after {clock(time.time() - started)}")
    if state != "completed":
        return None, j.get("error_message") or state
    matches = [e for e in http("GET", NOTEBOOK_API + "/podcasts/episodes")
               if e.get("name") == name and e.get("job_status") == "completed"]
    if not matches:
        return None, "job completed but the episode was not found"
    return max(matches, key=lambda e: e.get("created") or ""), None


def transcript_words(episode):
    turns = (episode.get("transcript") or {}).get("transcript", [])
    return sum(len(t.get("dialogue", "").split()) for t in turns)


def speaches_gpu_mib():
    """GPU memory held by the Speaches (Kokoro/Whisper) process, or None if unknown."""
    import subprocess
    try:
        out = subprocess.run(["nvidia-smi", "--query-compute-apps=process_name,used_memory",
                              "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    return sum(int(mem) for name, mem in (l.rsplit(",", 1) for l in out.strip().splitlines() if "," in l)
               if "speaches" in name)


SPEACHES_CONTAINER = setting("SPEACHES_CONTAINER", "speaches_container", "speaches")


def restart_speaches():
    """Restart the Speaches container to free leaked GPU memory. Needs a sudo rule
    for exactly this one command (the log says how to add it); without one,
    `sudo -n` fails at once instead of prompting, and the caller keeps waiting."""
    import subprocess
    log(f"  Speaches is holding GPU memory with no model loaded; restarting it...")
    try:
        r = subprocess.run(["sudo", "-n", "/usr/bin/docker", "restart", SPEACHES_CONTAINER],
                           capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"  (could not restart Speaches: {e})")
        return False
    if r.returncode != 0:
        log("  (no permission to restart Speaches automatically; to allow it, run once:\n"
            f"     echo '{os.environ.get('USER', 'YOUR_USER')} ALL=(root) NOPASSWD: /usr/bin/docker restart "
            f"{SPEACHES_CONTAINER}' | sudo tee /etc/sudoers.d/book2podcast && sudo chmod 440 /etc/sudoers.d/book2podcast)")
        return False
    for _ in range(60):   # until it answers again (one plain try each: http() would back off)
        try:
            urllib.request.urlopen(SPEACHES_URL + "/health", timeout=5).close()
            log("  Speaches restarted; GPU memory released")
            return True
        except (urllib.error.URLError, OSError):
            time.sleep(2)
    log("  (Speaches did not come back within 2 minutes)")
    return False


def free_gpu(everything=False):
    """Make room for the LLM before a chapter: Speaches keeps Kokoro on the GPU for
    minutes after rendering audio, which pushes the next chapter's LLM onto the CPU.
    everything=True also unloads every Ollama model (Docling wants the whole GPU)."""
    try:
        for m in http("GET", SPEACHES_URL + "/api/ps").get("models", []):
            mid = m if isinstance(m, str) else m.get("id") or m.get("model")
            try:
                http("DELETE", SPEACHES_URL + "/api/ps/" + urllib.parse.quote(mid, safe=""), raw=True)
                log(f"  unloaded {mid} from Speaches")
            except urllib.error.HTTPError as e:
                if e.code != 409:   # 409: idle and already counting down its TTL; just wait
                    raise
    except (urllib.error.URLError, ValueError) as e:
        log(f"  (could not unload Speaches models: {e})")
    held, waited, restarted = speaches_gpu_mib(), 0, False
    while held is not None and held > 500 and waited < 600:
        if waited == 0:
            log(f"  waiting for Speaches to release {held} MiB of GPU memory...")
        # Kokoro's idle timer (WHISPER__TTL=30) has run out by now; memory still held
        # is ONNX Runtime's leak, which only a restart gives back
        if waited >= 60 and not restarted:
            restarted = True
            if restart_speaches():
                held = speaches_gpu_mib()
                continue
        time.sleep(10)
        waited += 10
        held = speaches_gpu_mib()
        status(f"  waiting for the GPU: Speaches holds {held} MiB · {clock(waited)}")
    if held is not None and held > 2000 and not everything:
        # Its ONNX runtime keeps GPU memory after unloading Kokoro and it grows with
        # long episodes; past ~2 GB the next chapter's LLM runs out of memory, and
        # every chapter after it would fail the same way. Stop; a restart frees it.
        sys.exit(f"\nSpeaches is stuck holding {held} MiB of GPU memory, so the next episode would fail.\n"
                 f"Restart it:  cd ~/open-notebook && sudo docker restart speaches\n"
                 f"then run the same command again: finished episodes are kept, failed ones are redone.")
    if held is not None and held > 500:
        log(f"  Speaches still holds {held} MiB; continuing anyway (the LLM may run partly on CPU).")
    # an LLM that loaded while Kokoro was resident may be split onto the CPU; reload it cleanly
    try:
        for m in http("GET", OLLAMA_URL + "/api/ps").get("models", []):
            if everything or m.get("size_vram", 0) < m.get("size", 0):
                http("POST", OLLAMA_URL + "/api/generate", {"model": m["name"], "keep_alive": 0})
                log(f"  unloaded {m['name']} from Ollama{'' if everything else ' (was partly on CPU)'}")
    except urllib.error.URLError:
        pass


def generate_chapter(book, n, args, state):
    key = str(n)
    episodes = state.setdefault("episodes", {})
    if episodes.get(key, {}).get("status") == "completed":
        log(f"Chapter {n}: episode already done, skipping.")
        return
    ch = book["chapters"][n - 1]
    name = f"{book['title']} - {n:02d}. {ch['title']}"[:200]
    prev = episodes.get(key, {})
    if prev.get("status") == "running" and prev.get("job_id"):
        st = job_state(prev["job_id"])
        if st is not None and st not in ("failed", "error", "canceled", "cancelled"):
            log(f"Chapter {n}: picking up the job an earlier run started ({st})...")
            episode, error = wait_job(prev["job_id"], prev.get("name", name), prev.get("submitted", time.time()))
            return finish_chapter(n, args, state, prev.get("name", name), episode, error)
        log(f"Chapter {n}: the earlier job is gone ({st or 'unknown to Open Notebook'}); starting over.")
    log(f"Chapter {n}: generating \"{name}\" ({ch['words']:,} words of source)...")
    job_id = submit_job(name, ch["text"], briefing_suffix(book, n, book["chapters"]), args)
    # recorded before waiting: an interrupted run re-attaches to this job
    episodes[key] = {"name": name, "status": "running", "job_id": job_id, "submitted": time.time()}
    save_state(args.workdir, state)
    vlog(f"  Open Notebook job {job_id}")
    episode, error = wait_job(job_id, name, episodes[key]["submitted"])
    finish_chapter(n, args, state, name, episode, error)


def finish_chapter(n, args, state, name, episode, error):
    episodes, key = state.setdefault("episodes", {}), str(n)
    if error:
        episodes[key] = {"name": name, "status": "failed", "error": str(error)}
        save_state(args.workdir, state)
        log("  failed: " + str(error).replace("\n", "\n  "))
        return
    words = transcript_words(episode)
    episodes[key] = {"name": name, "status": "completed", "episode_id": episode["id"], "words": words}
    save_state(args.workdir, state)
    log(f"Chapter {n}: done, {words:,} words (~{words / 150:.0f} min)")


def safe_name(text):
    text = re.sub(r"\s*/\s*", " - ", text)                 # merged titles "A / B" -> "A - B"
    text = re.sub(r'[\\:*?"<>|\x00-\x1f]+', " ", text)
    return re.sub(r"\s+", " ", text).strip(" .-")[:150] or "episode"


def download_episode(book, n, args, state):
    """Save a finished episode to <out>/<book>/NN - Title.mp3, tagged so players
    group it (album = book, track = chapter). Skips files already there."""
    if args.no_download:
        return
    ep = state.get("episodes", {}).get(str(n), {})
    if ep.get("status") != "completed" or not ep.get("episode_id"):
        return
    folder = args.out / safe_name(book["title"])
    path = folder / f"{n:02d} - {safe_name(book['chapters'][n - 1]['title'])}.mp3"
    if path.exists():
        return
    folder.mkdir(parents=True, exist_ok=True)
    raw = path.with_suffix(".download")
    try:
        http("GET", f"{NOTEBOOK_API}/podcasts/episodes/{urllib.parse.quote(ep['episode_id'])}/audio",
             timeout=600, to_file=raw)
    except (urllib.error.URLError, OSError) as e:
        log(f"  could not download episode {n}: {e} (run the same command again to retry)")
        raw.unlink(missing_ok=True)
        return
    import subprocess
    tags = {"album": book["title"], "artist": book.get("author") or "", "title": book["chapters"][n - 1]["title"],
            "track": f"{n}/{len(book['chapters'])}", "genre": "Podcast"}
    tagged = path.with_suffix(".tagging.mp3")
    cmd = ["ffmpeg", "-loglevel", "error", "-y", "-i", str(raw), "-c", "copy", "-id3v2_version", "3"]
    for k, v in tags.items():
        cmd += ["-metadata", f"{k}={v}"]
    try:
        ok = subprocess.run(cmd + [str(tagged)], capture_output=True, timeout=300).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        ok = False
    if ok:
        os.replace(tagged, path)
        raw.unlink(missing_ok=True)
    else:   # no ffmpeg or it failed: keep the audio untagged
        tagged.unlink(missing_ok=True)
        os.replace(raw, path)
    log(f"  saved {path}")


def load_state(workdir):
    p = workdir / "state.json"
    return json.loads(p.read_text()) if p.exists() else {}


def save_state(workdir, state):
    write_atomic(workdir / "state.json", json.dumps(state, indent=1))


def write_atomic(path, text):
    """Write via a temp file and rename: a run killed mid-write (out of memory,
    Ctrl-C) must not leave a half-written chapters.json or state.json behind."""
    tmp = Path(str(path) + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


# ------------------------------------------------------------------------ main

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("query", nargs="?", help="book title (or author) to search for in Calibre-Web")
    ap.add_argument("--file", "--epub", dest="file", type=Path,
                    help="use a local EPUB or PDF file instead of Calibre-Web")
    ap.add_argument("--list", action="store_true", help="show detected chapters and stop")
    ap.add_argument("--chapters", default="all",
                    help='which chapters to turn into episodes, e.g. "3-7", "1,4" (default: all; finished ones are skipped)')
    ap.add_argument("--profile", default=setting("BOOK2PODCAST_PROFILE", "profile", "deep-dive"),
                    help="Open Notebook episode profile (default: deep-dive, as created by setup-profiles.sh)")
    ap.add_argument("--speakers", help="speaker profile (default: same name as --profile)")
    ap.add_argument("--resplit", action="store_true", help="ignore cached chapters.json and split again")
    ap.add_argument("--no-notebook", action="store_true", help="don't add chapters as notebook sources")
    ap.add_argument("--no-podcast", action="store_true", help="only split (and add sources), no episodes")
    ap.add_argument("--out", type=Path, default=Path.home() / "Podcasts",
                    help="folder to save finished episodes in, one subfolder per book (default: ~/Podcasts)")
    ap.add_argument("--no-download", action="store_true", help="leave the episodes in Open Notebook only")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="print every decision: each break's verdict and reason, each chapter summary")
    args = ap.parse_args()
    global VERBOSE
    VERBOSE = args.verbose

    known = None
    if args.file:
        args.workdir = CACHE_DIR / slug(args.file.stem)
        args.workdir.mkdir(parents=True, exist_ok=True)
        src = args.file
    elif args.query:
        src, args.workdir, known = fetch_book(args.query)
    else:
        ap.error("give a book title to search for, or --file EPUB/PDF")

    book = split_book(src, args.workdir, args.resplit, known)
    chapters = book["chapters"]
    if args.list:
        print(f"\n{book['title']} - {book['author']}  ({len(chapters)} chapters)\n")
        for n, c in enumerate(chapters, 1):
            print(f"{n:3d}. {c['title']}  [{c['words']:,} words]")
            print(f"     {c['summary'][:300]}")
        print(f"\nChapters are saved in {args.workdir / 'chapters.json'} (edit to adjust, --resplit to redo).")
        print('Run without --list to generate every episode (or e.g. --chapters 1-3 for some).')
        return

    picked = parse_range(args.chapters, len(chapters))
    log(f"{book['title']}: {len(chapters)} chapters; generating "
        f"{'all of them' if args.chapters == 'all' else 'chapters ' + args.chapters}.")
    state = load_state(args.workdir)
    if not args.no_notebook:
        ensure_notebook(book, state)
        for n in picked:
            add_source(book, n, chapters[n - 1], state)
        save_state(args.workdir, state)
        log(f"Chapters {picked[0]}-{picked[-1]} added to notebook \"{book['title']}\".")
    if not args.no_podcast:
        todo = [n for n in picked if state.get("episodes", {}).get(str(n), {}).get("status") != "completed"]
        run_start, finished = time.time(), 0
        for n in picked:
            if n in todo:
                left = ""
                if finished:
                    per = (time.time() - run_start) / finished
                    left = f" · ~{clock(per * (len(todo) - finished))} left for the rest"
                log(f"[episode {finished + 1} of {len(todo)}]{left}")
                # not while a job from an earlier run may still be using Kokoro/the LLM
                if state.get("episodes", {}).get(str(n), {}).get("status") != "running":
                    free_gpu()
            generate_chapter(book, n, args, state)
            download_episode(book, n, args, state)   # also fetches earlier episodes missing from the folder
            finished += n in todo
        where = "" if args.no_download else f" and in {args.out / safe_name(book['title'])}"
        log(f"Done in {clock(time.time() - run_start)}. Episodes are in Open Notebook under Podcasts{where}.")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit("\nStopped. An episode that was being made keeps going in Open Notebook; "
                 "run the same command again to pick it up and continue.")
