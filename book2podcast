def setting(env, key, default):
    """Environment variable, else ~/.config/book2podcast/config.json, else default."""
    if os.environ.get(env):
        return os.environ[env]
    try:
        return json.loads((CONFIG_DIR / "config.json").read_text()).get(key) or default
    except (OSError, ValueError):
        return default


